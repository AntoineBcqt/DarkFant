<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/OptionsPanel.uss?fileID=7433441132597879392&amp;guid=8a025a542d7067c4d9f156853b576514&amp;type=3#OptionsPanel"/>
    <ui:VisualElement name="options-root" style="width: 100%; height: 100%; align-items: center; justify-content: center; background-color: rgba(4, 2, 10, 0.85);">
        <ui:VisualElement name="options-panel" class="options-panel">
            <ui:VisualElement class="corner-crystal corner-tl"/>
            <ui:VisualElement class="corner-crystal corner-tr"/>
            <ui:VisualElement class="corner-crystal corner-bl"/>
            <ui:VisualElement class="corner-crystal corner-br"/>
            <ui:Label text="OPTIONS" class="options-title"/>
            <ui:VisualElement class="options-divider"/>
            <ui:Label text="AUDIO" class="section-label"/>
            <ui:VisualElement class="option-row">
                <ui:Label text="Musique" class="option-label"/>
                <ui:Slider name="slider-music" low-value="0" high-value="1" value="0.7" class="option-slider"/>
                <ui:Label name="label-music-val" text="70" class="option-value"/>
            </ui:VisualElement>
            <ui:VisualElement class="option-row">
                <ui:Label text="SFX" class="option-label"/>
                <ui:Slider name="slider-sfx" low-value="0" high-value="1" value="1" class="option-slider"/>
                <ui:Label name="label-sfx-val" text="100" class="option-value"/>
            </ui:VisualElement>
            <ui:VisualElement class="options-divider"/>
            <ui:Label text="AFFICHAGE" class="section-label"/>
            <ui:VisualElement class="option-row">
                <ui:Label text="Plein écran" class="option-label"/>
                <ui:Toggle name="toggle-fullscreen" class="option-toggle"/>
            </ui:VisualElement>
            <ui:VisualElement class="option-row">
                <ui:Label text="Résolution" class="option-label"/>
                <ui:DropdownField name="dropdown-resolution" class="option-dropdown"/>
            </ui:VisualElement>
            <ui:VisualElement class="options-divider"/>
            <ui:Label text="CONTRÔLES" class="section-label"/>
            <ui:VisualElement class="controls-grid">
                <ui:VisualElement class="control-row">
                    <ui:Label text="Attaquer" class="control-label"/>
                    <ui:Label text="A" class="control-key"/>
                </ui:VisualElement>
                <ui:VisualElement class="control-row">
                    <ui:Label text="Dash" class="control-label"/>
                    <ui:Label text="B" class="control-key"/>
                </ui:VisualElement>
                <ui:VisualElement class="control-row">
                    <ui:Label text="Compétence" class="control-label"/>
                    <ui:Label text="Y" class="control-key"/>
                </ui:VisualElement>
                <ui:VisualElement class="control-row">
                    <ui:Label text="Interagir" class="control-label"/>
                    <ui:Label text="X" class="control-key"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="options-divider"/>
            <ui:VisualElement class="options-buttons">
                <ui:Button name="btn-apply" text="APPLIQUER" class="options-btn btn-apply"/>
                <ui:Button name="btn-close" text="FERMER" class="options-btn btn-close"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
