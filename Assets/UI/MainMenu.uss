.root {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background-color: rgb(10, 10, 18);
    position: absolute;
    overflow: hidden;
}

.stars-layer {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

.stalactites-top {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 80px;
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-around;
}

.stal {
    background-color: rgb(13, 13, 30);
    width: 60px;
    align-self: flex-start;
}

.stal-1 {
    height: 45px;
    margin-left: 10px;
}

.stal-2 {
    height: 65px;
}

.stal-3 {
    height: 50px;
}

.stal-4 {
    height: 72px;
}

.stal-5 {
    height: 38px;
}

.stal-6 {
    height: 58px;
    margin-right: 10px;
}

.stalactites-bottom {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 80px;
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-around;
}

.stalag {
    background-color: rgb(13, 13, 30);
    width: 80px;
    align-self: flex-end;
}

.stalag-1 {
    height: 50px;
    margin-left: 20px;
}

.stalag-2 {
    height: 70px;
}

.stalag-3 {
    height: 40px;
}

.stalag-4 {
    height: 60px;
}

.stalag-5 {
    height: 48px;
    margin-right: 20px;
}

.menu-container {
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.title-block {
    flex-direction: column;
    align-items: center;
    margin-bottom: 40px;
}

.game-title {
    font-size: 42px;
    color: rgb(212, 168, 255);
    -unity-font-style: normal;
    letter-spacing: 6px;
    margin-top: 0;
    margin-bottom: 0;
}

.game-subtitle {
    font-size: 11px;
    color: rgb(90, 60, 120);
    letter-spacing: 4px;
    margin-top: 10px;
}

.menu-frame {
    flex-direction: column;
    align-items: center;
    padding: 28px 48px;
    border-width: 2px;
    border-color: rgb(58, 26, 110);
    background-color: rgba(20, 8, 40, 0.6);
    position: relative;
}

.corner-crystal {
    position: absolute;
    width: 8px;
    height: 8px;
    background-color: rgb(123, 53, 204);
}

.corner-tl {
    top: -1px;
    left: -1px;
}

.corner-tr {
    top: -1px;
    right: -1px;
}

.corner-bl {
    bottom: -1px;
    left: -1px;
}

.corner-br {
    bottom: -1px;
    right: -1px;
}

.menu-btn {
    width: 240px;
    height: 48px;
    font-size: 14px;
    letter-spacing: 2px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 2px;
    border-color: rgb(90, 46, 138);
    color: rgb(224, 200, 255);
    margin-bottom: 0;
    transition-duration: 0.1s;
    transition-property: background-color, border-color, color;
    cursor: link;
}

.menu-btn:hover {
    background-color: rgba(42, 16, 64, 0.8);
    border-color: rgb(176, 106, 255);
    color: rgb(255, 255, 255);
}

.menu-btn:active {
    background-color: rgba(58, 24, 96, 0.9);
    scale: 0.98;
}

.btn-start {
    border-color: rgb(128, 64, 192);
    color: rgb(212, 168, 255);
    margin-bottom: 0;
}

.btn-start:hover {
    background-color: rgba(58, 24, 96, 0.8);
    border-color: rgb(212, 168, 255);
    color: rgb(255, 255, 255);
}

.pixel-divider {
    width: 240px;
    height: 2px;
    background-color: rgb(58, 26, 110);
    margin-top: 14px;
    margin-bottom: 14px;
}

.version-tag {
    font-size: 9px;
    color: rgb(50, 35, 75);
    letter-spacing: 2px;
    margin-top: 32px;
}


